{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/",
	"login": false,
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "setSiteLanguage",
			"language": "sk_SK"
		},
		{
			"step": "setSiteLanguage",
			"language": "de_DE"
		},
		{
			"step": "setSiteOptions",
			"options": {
				"blogname": "MedCentrum",
				"blogdescription": "Gesundheit & Vorsorge",
				"timezone_string": "Europe/Bratislava",
				"start_of_week": 1,
				"permalink_structure": "/%postname%/"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "polylang"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/viliam-polakovic/medcentrum-demo/main/dist/medcentrum-objednavanie-plugin.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/viliam-polakovic/medcentrum-demo/main/dist/medcentrum-tema.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/demo-content.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/viliam-polakovic/medcentrum-demo/main/playground/demo-content.php"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/demo-content.php';"
		}
	]
}